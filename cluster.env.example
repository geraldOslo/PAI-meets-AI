# Local cluster settings. Copy to cluster.env (gitignored) and edit:
#   cp cluster.env.example cluster.env
#
# Read by code/slurm_scripts/submit.sh (sbatch options), code/slurm_scripts/job_env.sh
# (inside every job) and code/cluster_env.py (hyperparam_search_phase*.py generators).
# One KEY=value per line, quote values that contain spaces. A variable that is already
# set in the environment wins, e.g.  DATA_DIR=/other/clips code/slurm_scripts/submit.sh ...

# --- Slurm: sbatch reads these SBATCH_* variables ---
SBATCH_ACCOUNT=your_project_account
SBATCH_PARTITION=your_gpu_partition
# GPU request; the scripts ask for any GPU (gpu:1) unless set, e.g. gpu:a100:1
# SBATCH_GRES=gpu:1

# --- Software loaded inside each job ---
MODULES="Python/3.11 CUDA/12"
VENV_PATH=/path/to/python_venv

# Optional: a different environment for run_summary.sh (empty VENV_PATH = no venv)
# SUMMARY_MODULES="PyTorch/2.1"
# SUMMARY_VENV_PATH=

# --- Data and models ---
# Folder with data.csv and the image clips (slurm_batch_inference.sh)
DATA_DIR=/path/to/clips
# Folder with resnet50_best.pth, efficientnet-b3_best.pth, convnext-tiny_best.pth
# (default: <repository>/model_checkpoints)
# MODEL_CHECKPOINTS_BASE=/path/to/model_checkpoints
