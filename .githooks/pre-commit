#!/bin/bash
# Refuse a commit whose added lines contain local values from cluster.env
# (the Slurm account and any path). Enable once per clone:
#   git config core.hooksPath .githooks
# Bypass for a deliberate exception:  git commit --no-verify

root="$(git rev-parse --show-toplevel)"
env_file="$root/cluster.env"
[ -f "$env_file" ] || exit 0

added="$(git diff --cached --no-color -U0 --diff-filter=ACMR | grep '^+' | grep -v '^+++')"
[ -n "$added" ] || exit 0

status=0
while IFS= read -r line || [ -n "$line" ]; do
    line="${line#"${line%%[![:space:]]*}"}"
    case "$line" in ''|\#*) continue ;; esac
    line="${line#export }"
    key="${line%%=*}"
    value="${line#*=}"
    value="${value%%[[:space:]]#*}"
    value="${value%\"}"; value="${value#\"}"; value="${value%\'}"; value="${value#\'}"
    if [ "$key" != "SBATCH_ACCOUNT" ]; then
        case "$value" in /*) ;; *) continue ;; esac
    fi
    [ ${#value} -ge 4 ] || continue
    if printf '%s\n' "$added" | grep -qF -- "$value"; then
        echo "pre-commit: staged changes contain $key from cluster.env: $value" >&2
        status=1
    fi
done < "$env_file"

[ $status -eq 0 ] || echo "Use a placeholder or a cluster.env variable instead, or commit with --no-verify." >&2
exit $status
